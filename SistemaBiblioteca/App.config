<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Ajuste Server según su instancia: localhost, .\SQLEXPRESS, (localdb)\MSSQLLocalDB, etc. -->
    <add name="BibliotecaDB"
         connectionString="Server=(localdb)\MSSQLLocalDB;Database=BibliotecaDB;Integrated Security=True;TrustServerCertificate=True;"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
